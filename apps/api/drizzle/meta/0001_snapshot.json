        },
        "calendario_semanal": {
          "name": "calendario_semanal",
          "value": "isfinite(\"mercado\".\"versoes_dados\".\"primeira_semana\") AND extract(isodow FROM \"mercado\".\"versoes_dados\".\"primeira_semana\") = 1 AND isfinite(\"mercado\".\"versoes_dados\".\"ultima_semana\") AND extract(isodow FROM \"mercado\".\"versoes_dados\".\"ultima_semana\") = 1 AND isfinite(\"mercado\".\"versoes_dados\".\"semana_anterior\") AND extract(isodow FROM \"mercado\".\"versoes_dados\".\"semana_anterior\") = 1 AND \"mercado\".\"versoes_dados\".\"primeira_semana\" BETWEEN \"mercado\".\"versoes_dados\".\"janela_inicio\" AND \"mercado\".\"versoes_dados\".\"janela_inicio\" + 6 AND \"mercado\".\"versoes_dados\".\"ultima_semana\" BETWEEN \"mercado\".\"versoes_dados\".\"janela_fim\" - 6 AND \"mercado\".\"versoes_dados\".\"janela_fim\" AND \"mercado\".\"versoes_dados\".\"semana_anterior\" = \"mercado\".\"versoes_dados\".\"primeira_semana\" - 7"
        },
